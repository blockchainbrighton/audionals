{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Bam Mono",
    "description": "Legacy port preset over UniversalSynth."
  },
  "config": {
    "name": "Bam Mono",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": false,
    "modules": [
      {
        "name": "Osc 1",
        "cols": 1,
        "controls": [
          {
            "id": "osc1_wave",
            "param": 0,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 1,
            "label": "Wave"
          },
          {
            "id": "osc1_tune",
            "param": 1,
            "type": "knob",
            "min": -24,
            "max": 24,
            "step": 1,
            "val": 0,
            "label": "Tune"
          },
          {
            "id": "osc1_mix",
            "param": 2,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.9,
            "label": "Level"
          }
        ]
      },
      {
        "name": "Osc 2",
        "cols": 1,
        "controls": [
          {
            "id": "osc2_wave",
            "param": 4,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 2,
            "label": "Wave"
          },
          {
            "id": "osc2_tune",
            "param": 5,
            "type": "knob",
            "min": -24,
            "max": 24,
            "step": 1,
            "val": 0,
            "label": "Tune"
          },
          {
            "id": "osc2_det",
            "param": 6,
            "type": "knob",
            "min": 0,
            "max": 0.5,
            "val": 0.03,
            "label": "Fine"
          },
          {
            "id": "osc2_mix",
            "param": 7,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.15,
            "label": "Level"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_mode",
            "param": 12,
            "type": "select",
            "options": [
              "LP",
              "HP",
