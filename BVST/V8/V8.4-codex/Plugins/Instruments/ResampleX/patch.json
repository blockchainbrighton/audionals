{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "ResampleX",
    "description": "Lo-fi resampling sampler patch (bitcrush + downsample)."
  },
  "config": {
    "name": "ResampleX",
    "visualizer": "spectrum",
    "sampler": {},
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "modules": [
      {
        "name": "Transport",
        "cols": 1,
        "controls": [
          { "id": "btn-power", "param": -1, "type": "button", "text": "PWR", "label": "Context" }
        ]
      },
      {
        "name": "Playback / Loop",
        "cols": 1,
        "controls": [
          { "id": "speed", "param": 0, "type": "knob", "min": 0, "max": 4, "val": 1.0, "label": "Speed" },
          { "id": "reverse", "param": 4, "type": "switch", "val": 0, "label": "Reverse" },
          { "id": "loop_enable", "param": 3, "type": "switch", "val": 0, "label": "Loop" },
          { "id": "loop_start", "param": 1, "type": "slider", "min": 0, "max": 1, "val": 0.0, "label": "Start" },
          { "id": "loop_end", "param": 2, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "End" }
        ]
      },
      {
        "name": "Resample",
        "cols": 1,
        "controls": [
          { "id": "bits", "param": 9, "type": "knob", "min": 1, "max": 16, "val": 12, "label": "Bits" },
          { "id": "redux", "param": 10, "type": "knob", "min": 1, "max": 50, "val": 4, "label": "Redux" },
          { "id": "gain", "param": 22, "type": "knob", "min": 0, "max": 2, "val": 0.9, "label": "Gain" },
          { "id": "drive", "param": 23, "type": "knob", "min": 0, "max": 1, "val": 0.0, "label": "Drive" }
        ]
      },
      {
        "name": "Filter / Env / Pos",
        "cols": 1,
        "controls": [
          { "id": "filt_mode", "param": 13, "type": "select", "options": ["LP", "HP", "BP", "Notch"], "val": 0, "label": "Mode" },
          { "id": "cut", "param": 11, "type": "knob", "min": 20, "max": 20000, "val": 14000, "curve": "log", "label": "Cut" },
          { "id": "res", "param": 12, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" },
          { "id": "att", "param": 20, "type": "slider", "min": 0.001, "max": 2, "val": 0.005, "label": "A" },
          { "id": "rel", "param": 21, "type": "slider", "min": 0.001, "max": 5, "val": 0.25, "label": "R" },
          { "id": "pos", "param": 5, "type": "slider", "min": 0, "max": 1, "val": 0.0, "label": "Pos" }
        ]
      }
    ]
  }
}

