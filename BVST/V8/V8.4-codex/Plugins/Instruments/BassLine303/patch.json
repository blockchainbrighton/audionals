{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "BassLine 303",
    "description": "Legacy port preset over UniversalSynth with step sequencer (shared engine)."
  },
  "config": {
    "name": "BassLine 303",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": {
      "type": "step",
      "steps": 16,
      "paramMap": {
        "note": 128,
        "gate": 129,
        "accent": -1,
        "slide": -1
      }
    },
    "modules": [
      {
        "name": "Transport",
        "cols": 1,
        "controls": [
          {
            "id": "btn-power",
            "param": -1,
            "type": "button",
            "text": "PWR",
            "label": "Context"
          },
          {
            "id": "btn-play",
            "param": -1,
            "type": "button",
            "text": "PLAY",
            "label": "Seq"
          },
          {
            "id": "btn-stop",
            "param": -1,
            "type": "button",
            "text": "STOP",
            "label": "Seq"
          },
          {
            "id": "bpm",
            "param": -1,
            "type": "knob",
            "min": 60,
            "max": 180,
            "val": 130,
            "label": "BPM"
          },
          {
            "id": "swing",
            "param": -1,
            "type": "knob",
            "min": 0,
            "max": 0.75,
            "val": 0.0,
            "label": "Swing"
          }
        ]
      },
      {
        "name": "Osc",
        "cols": 1,
        "controls": [
          {
            "id": "osc1_wave",
            "param": 0,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 1,
            "label": "Wave"
          },
          {
            "id": "osc1_mix",
            "param": 2,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 1.0,
            "label": "Level"
          },
          {
            "id": "osc2_mix",
            "param": 7,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.0,
            "label": "Osc2"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_mode",
            "param": 12,
            "type": "select",
            "options": [
              "LP",
              "HP",
              "BP",
              "Notch"
            ],
            "val": 0,
            "label": "Mode"
          },
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 600,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 6.0,
            "label": "Res"
          },
          {
            "id": "filt_env",
            "param": 13,
            "type": "knob",
            "min": -1,
            "max": 1,
            "val": 0.8,
            "label": "Env Amt"
          }
        ]
      },
      {
        "name": "Env",
        "cols": 1,
        "controls": [
          {
            "id": "amp_d",
            "param": 15,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.25,
            "label": "Amp D"
          },
          {
            "id": "amp_s",
            "param": 16,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.0,
            "label": "Amp S"
          },
          {
            "id": "amp_r",
            "param": 17,
            "type": "slider",
            "min": 0.001,
            "max": 5,
            "val": 0.15,
            "label": "Amp R"
          },
          {
            "id": "filt_d",
            "param": 19,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.22,
            "label": "Filt D"
          }
        ]
      },
      {
        "name": "Drive",
        "cols": 1,
        "controls": [
          {
            "id": "drive",
            "param": 9,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.55,
            "label": "Drive"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.8,
            "label": "Master"
          }
        ]
      }
    ]
  }
}
