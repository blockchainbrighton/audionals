{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Morph Filter",
    "description": "Legacy port preset over UniversalSynth (noise/drone focus)."
  },
  "config": {
    "name": "Morph Filter",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": false,
    "modules": [
      {
        "name": "Noise / Drive",
        "cols": 1,
        "controls": [
          {
            "id": "noise",
            "param": 8,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.6,
            "label": "Noise"
          },
          {
            "id": "drive",
            "param": 9,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.35,
            "label": "Drive"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.6,
            "label": "Master"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_mode",
            "param": 12,
            "type": "select",
            "options": [
              "LP",
              "HP",
              "BP",
              "Notch"
            ],
            "val": 2,
            "label": "Mode"
          },
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 1200,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 3.5,
            "label": "Res"
          }
        ]
      },
      {
        "name": "LFO",
        "cols": 1,
        "controls": [
          {
            "id": "lfo_rate",
            "param": 22,
            "type": "knob",
            "min": 0.1,
            "max": 20,
            "val": 0.6,
            "label": "Rate"
          },
          {
            "id": "lfo_depth",
            "param": 23,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.25,
            "label": "Depth"
          },
          {
            "id": "lfo_dest",
            "param": 24,
            "type": "select",
            "options": [
              "Off",
              "Cutoff",
              "Pitch"
            ],
            "val": 1,
            "label": "Dest"
          }
        ]
      }
    ]
  }
}
