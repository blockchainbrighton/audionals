{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "SliceMaster",
    "description": "Slice chopper: map notes to 8 slices."
  },
  "config": {
    "name": "SliceMaster",
    "visualizer": "spectrum",
    "sampler": {},
    "keyboard": {
      "startNote": 48,
      "numKeys": 25
    },
    "modules": [
      {
        "name": "Transport",
        "cols": 1,
        "controls": [
          { "id": "btn-power", "param": -1, "type": "button", "text": "PWR", "label": "Context" }
        ]
      },
      {
        "name": "Playback",
        "cols": 1,
        "controls": [
          { "id": "speed", "param": 0, "type": "knob", "min": 0, "max": 4, "val": 1.0, "label": "Speed" },
          { "id": "reverse", "param": 4, "type": "switch", "val": 0, "label": "Reverse" },
          { "id": "gain", "param": 22, "type": "knob", "min": 0, "max": 2, "val": 0.9, "label": "Gain" },
          { "id": "drive", "param": 23, "type": "knob", "min": 0, "max": 1, "val": 0.0, "label": "Drive" }
        ]
      },
      {
        "name": "Filter / Env",
        "cols": 1,
        "controls": [
          { "id": "filt_mode", "param": 13, "type": "select", "options": ["LP", "HP", "BP", "Notch"], "val": 0, "label": "Mode" },
          { "id": "cut", "param": 11, "type": "knob", "min": 20, "max": 20000, "val": 18000, "curve": "log", "label": "Cut" },
          { "id": "res", "param": 12, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" },
          { "id": "att", "param": 20, "type": "slider", "min": 0.001, "max": 2, "val": 0.001, "label": "A" },
          { "id": "rel", "param": 21, "type": "slider", "min": 0.001, "max": 5, "val": 0.2, "label": "R" }
        ]
      },
      {
        "name": "Wave",
        "cols": 1,
        "controls": [
          { "id": "pos", "param": 5, "type": "slider", "min": 0, "max": 1, "val": 0.0, "label": "Pos" },
          { "id": "spread", "param": 6, "type": "knob", "min": 0, "max": 1, "val": 0.1, "label": "Spread" }
        ]
      }
    ],
    "presets": {
      "Init": {
        "speed": 1.0,
        "reverse": 0,
        "gain": 0.9,
        "drive": 0.0,
        "filt_mode": 0,
        "cut": 18000,
        "res": 0.7,
        "att": 0.001,
        "rel": 0.2,
        "pos": 0.0,
        "spread": 0.1
      }
    }
  }
}
