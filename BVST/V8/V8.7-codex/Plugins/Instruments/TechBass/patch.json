        "osc1_mix": 1.0,
        "osc2_wave": 0,
        "osc2_mix": 0.2,
        "filt_cut": 140,
        "filt_res": 0.8,
        "filt_env": 0.0,
        "amp_a": 0.002,
        "amp_d": 0.18,
        "amp_s": 1.0,
        "amp_r": 0.25,
        "drive": 0.25,
        "master": 0.85
      },
      "Hard Acid": {
        "osc1_wave": 1,
        "osc1_mix": 1.0,
        "osc2_wave": 1,
        "osc2_mix": 0.55,
        "filt_cut": 320,
        "filt_res": 7.5,
        "filt_env": 0.9,
        "amp_a": 0.002,
        "amp_d": 0.15,
        "amp_s": 0.0,
        "amp_r": 0.12,
