        "filt_env": 0.35,
        "amp_a": 0.002,
        "amp_d": 0.22,
        "amp_s": 0.0,
        "amp_r": 0.15,
        "drive": 0.55,
        "master": 0.78
      },
      "Reese-ish": {
        "osc1_wave": 1,
        "osc1_mix": 0.95,
        "osc2_wave": 1,
        "osc2_mix": 0.95,
        "filt_cut": 900,
        "filt_res": 1.0,
        "filt_env": 0.25,
        "amp_a": 0.002,
        "amp_d": 0.4,
        "amp_s": 0.85,
