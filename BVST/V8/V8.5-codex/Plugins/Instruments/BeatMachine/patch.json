{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "BeatMachine",
    "description": "Drum machine + grid sequencer."
  },
  "config": {
    "name": "BeatMachine",
    "visualizer": "spectrum",
    "keyboard": false,
    "sequencer": {
      "type": "grid",
      "steps": 16,
      "paramMap": {
        "note": 128
      },
      "initialData": [
        [true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, false],
        [false, false, false, false, true, false, false, false, false, false, false, false, true, false, false, false],
        [false, false, true, false, false, false, true, false, false, false, true, false, false, false, true, false],
        [true, false, false, true, false, false, false, false, true, false, false, true, false, false, false, false]
      ],
      "rows": [
        { "name": "KICK", "note": 36, "class": "row-0" },
        { "name": "SNARE", "note": 38, "class": "row-1" },
        { "name": "HAT", "note": 42, "class": "row-2" },
        { "name": "BASS", "note": 48, "class": "row-3" }
      ]
    },
    "modules": [
      {
        "name": "Kick",
        "cols": 1,
        "controls": [
          { "id": "k_vol", "param": 1, "type": "knob", "min": 0, "max": 1, "val": 0.8, "label": "Vol" },
          { "id": "k_tune", "param": 5, "type": "knob", "min": 30, "max": 80, "val": 50, "label": "Tune" },
          { "id": "k_dec", "param": 6, "type": "knob", "min": 0.1, "max": 0.8, "val": 0.4, "label": "Decay" }
        ]
      },
      {
        "name": "Snare",
        "cols": 1,
        "controls": [
          { "id": "s_vol", "param": 2, "type": "knob", "min": 0, "max": 1, "val": 0.6, "label": "Vol" },
          { "id": "s_snap", "param": 7, "type": "knob", "min": 0, "max": 1, "val": 0.5, "label": "Snap" },
          { "id": "s_dec", "param": 8, "type": "knob", "min": 0.05, "max": 0.4, "val": 0.2, "label": "Decay" }
        ]
      },
      {
        "name": "Hat",
        "cols": 1,
        "controls": [
          { "id": "h_vol", "param": 3, "type": "knob", "min": 0, "max": 1, "val": 0.4, "label": "Vol" },
          { "id": "h_col", "param": 9, "type": "knob", "min": 1000, "max": 10000, "val": 5000, "curve": "log", "label": "Color" },
          { "id": "h_dec", "param": 10, "type": "knob", "min": 0.02, "max": 0.3, "val": 0.05, "label": "Decay" }
        ]
      },
      {
        "name": "Bass",
        "cols": 1,
        "controls": [
          { "id": "b_vol", "param": 4, "type": "knob", "min": 0, "max": 1, "val": 0.7, "label": "Vol" },
          { "id": "b_cut", "param": 11, "type": "knob", "min": 100, "max": 2000, "val": 500, "curve": "log", "label": "Cut" },
          { "id": "b_dec", "param": 12, "type": "knob", "min": 0.1, "max": 1.0, "val": 0.3, "label": "Decay" },
          { "id": "b_note", "param": 13, "type": "knob", "min": 24, "max": 60, "step": 1, "val": 36, "label": "Root" }
        ]
      },
      {
        "name": "Sequencer",
        "cols": 1,
        "controls": [
          { "id": "btn-play", "param": -1, "type": "button", "text": "PLAY", "label": "Seq" },
          { "id": "btn-stop", "param": -1, "type": "button", "text": "STOP", "label": "Seq" },
          { "id": "bpm", "param": -1, "type": "knob", "min": 60, "max": 200, "val": 120, "step": 1, "label": "BPM" }
        ]
      }
    ]
  }
}

