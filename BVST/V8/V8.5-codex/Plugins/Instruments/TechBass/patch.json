{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Tech Bass",
    "description": "Legacy port preset over UniversalSynth."
  },
  "config": {
    "name": "Tech Bass",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 24,
      "numKeys": 37
    },
    "sequencer": false,
    "modules": [
      {
        "name": "Osc",
        "cols": 1,
        "controls": [
          {
            "id": "osc1_wave",
            "param": 0,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 1,
            "label": "Wave"
          },
          {
            "id": "osc1_mix",
            "param": 2,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 1.0,
            "label": "Level"
          },
          {
            "id": "osc2_wave",
            "param": 4,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 2,
            "label": "Wave"
          },
          {
            "id": "osc2_mix",
            "param": 7,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.35,
            "label": "Level"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 450,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 3.2,
            "label": "Res"
          },
          {
            "id": "filt_env",
            "param": 13,
            "type": "knob",
            "min": -1,
            "max": 1,
            "val": 0.7,
            "label": "Env Amt"
          }
        ]
      },
      {
        "name": "Amp Env",
        "cols": 1,
        "controls": [
          {
            "id": "amp_a",
            "param": 14,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.002,
            "label": "A"
          },
          {
            "id": "amp_d",
            "param": 15,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.18,
            "label": "D"
          },
          {
            "id": "amp_s",
            "param": 16,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.5,
            "label": "S"
          },
          {
            "id": "amp_r",
            "param": 17,
            "type": "slider",
            "min": 0.001,
            "max": 5,
            "val": 0.2,
            "label": "R"
          }
        ]
      },
      {
        "name": "Drive",
        "cols": 1,
        "controls": [
          {
            "id": "drive",
            "param": 9,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.8,
            "label": "Drive"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.75,
            "label": "Master"
          }
        ]
      }
    ]
  }
}
