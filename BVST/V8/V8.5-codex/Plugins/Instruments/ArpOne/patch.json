{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Arp One",
    "description": "Legacy port: plucky monosynth + JS arpeggiator (shared engine)."
  },
  "config": {
    "name": "Arp One",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": {
      "type": "arp",
      "steps": 16,
      "paramMap": {
        "note": 128,
        "gate": 129
      }
    },
    "modules": [
      {
        "name": "Arp",
        "cols": 1,
        "controls": [
          {
            "id": "arp_enable",
            "param": -1,
            "type": "switch",
            "val": 0,
            "label": "On"
          },
          {
            "id": "arp_dir",
            "param": -1,
            "type": "select",
            "options": [
              "up",
              "down",
              "updown",
              "random"
            ],
            "val": 0,
            "label": "Dir"
          },
          {
            "id": "arp_rate",
            "param": -1,
            "type": "knob",
            "min": 0.05,
            "max": 0.5,
            "val": 0.125,
            "label": "Rate"
          },
          {
            "id": "arp_oct",
            "param": -1,
            "type": "knob",
            "min": 1,
            "max": 3,
            "step": 1,
            "val": 1,
            "label": "Oct"
          }
        ]
      },
      {
        "name": "Voice",
        "cols": 1,
        "controls": [
          {
            "id": "osc1_wave",
            "param": 0,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 2,
            "label": "Wave"
          },
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 900,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 2.8,
            "label": "Res"
          },
          {
            "id": "amp_d",
            "param": 15,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.18,
            "label": "Decay"
          },
          {
            "id": "amp_s",
            "param": 16,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.0,
            "label": "Sustain"
          },
          {
            "id": "amp_r",
            "param": 17,
            "type": "slider",
            "min": 0.001,
            "max": 5,
            "val": 0.12,
            "label": "Release"
          },
          {
            "id": "drive",
            "param": 9,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.25,
            "label": "Drive"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.8,
            "label": "Master"
          }
        ]
      }
    ]
  }
}
