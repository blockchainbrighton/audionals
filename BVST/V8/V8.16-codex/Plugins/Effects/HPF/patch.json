{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "HPF",
    "description": "High-pass filter with resonance and drive (UniversalFilter)."
  },
  "config": {
    "name": "HPF",
    "visualizer": "spectrum",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Init",
    "modules": [
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          { "id": "mode", "param": 0, "type": "select", "options": ["LP", "HP", "BP", "Notch"], "val": 1, "label": "Mode" },
          { "id": "cut", "param": 1, "type": "knob", "min": 20, "max": 20000, "val": 120, "curve": "log", "label": "Cutoff" },
          { "id": "res", "param": 2, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" },
          { "id": "drive", "param": 3, "type": "knob", "min": 0, "max": 1, "val": 0.0, "label": "Drive" },
          { "id": "mix", "param": 4, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Mix" }
        ]
      }
    ],
    "presets": {
      "Init": { "mode": 1, "cut": 120, "res": 0.7, "drive": 0.0, "mix": 1.0 },
      "Tighten Low End": { "mode": 1, "cut": 80, "res": 0.7, "drive": 0.0, "mix": 1.0 },
      "DJ Filter": { "mode": 1, "cut": 350, "res": 1.6, "drive": 0.05, "mix": 1.0 }
    }
  }
}
