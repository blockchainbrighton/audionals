{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Graphic EQ 5",
    "description": "5-band graphic EQ with fader-style controls."
  },
  "config": {
    "name": "Graphic EQ 5",
    "visualizer": "spectrum",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Init",
    "modules": [
      {
        "name": "Bands",
        "cols": 2,
        "controls": [
          { "id": "b100", "param": 0, "type": "slider", "min": -24, "max": 24, "val": 0, "label": "100 Hz" },
          { "id": "b300", "param": 1, "type": "slider", "min": -24, "max": 24, "val": 0, "label": "300 Hz" },
          { "id": "b1k", "param": 2, "type": "slider", "min": -24, "max": 24, "val": 0, "label": "1 kHz" },
          { "id": "b3k", "param": 3, "type": "slider", "min": -24, "max": 24, "val": 0, "label": "3 kHz" },
          { "id": "b10k", "param": 4, "type": "slider", "min": -24, "max": 24, "val": 0, "label": "10 kHz" }
        ]
      },
      {
        "name": "Output",
        "cols": 1,
        "controls": [
          { "id": "out", "param": 5, "type": "knob", "min": -12, "max": 12, "val": 0, "label": "Out (dB)" }
        ]
      }
    ],
    "presets": {
      "Init": { "b100": 0, "b300": 0, "b1k": 0, "b3k": 0, "b10k": 0, "out": 0 },
      "Smile": { "b100": 4.0, "b300": -2.0, "b1k": -3.0, "b3k": 1.5, "b10k": 4.0, "out": 0 },
      "Telephone": { "b100": -18.0, "b300": -6.0, "b1k": 6.0, "b3k": 8.0, "b10k": -12.0, "out": -2.0 },
      "Warm": { "b100": 2.5, "b300": 1.5, "b1k": -1.0, "b3k": -0.5, "b10k": 1.0, "out": 0 }
    }
  }
}
