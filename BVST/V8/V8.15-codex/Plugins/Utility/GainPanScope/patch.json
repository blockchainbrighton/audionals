{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Gain Pan Scope",
    "description": "Legacy port preset over UniversalUtility."
  },
  "config": {
    "name": "Gain Pan Scope",
    "visualizer": "spectrum",
    "keyboard": false,
    "sequencer": false,
    "modules": [
      {
        "name": "Input & Stereo",
        "cols": 1,
        "controls": [
          {
            "id": "in_gain",
            "param": 3,
            "type": "knob",
            "min": 0,
            "max": 2,
            "val": 1.0,
            "label": "In Gain"
          },
          {
            "id": "pan",
            "param": 4,
            "type": "knob",
            "min": -1,
            "max": 1,
            "val": 0,
            "label": "Pan"
          },
          {
            "id": "width",
            "param": 5,
            "type": "knob",
            "min": 0,
            "max": 2,
            "val": 1.0,
            "label": "Width"
          }
        ]
      },
      {
        "name": "Phase",
        "cols": 1,
        "controls": [
          {
            "id": "ph_l",
            "param": 6,
            "type": "switch",
            "val": 0,
            "label": "Inv L"
          },
          {
            "id": "ph_r",
            "param": 7,
            "type": "switch",
            "val": 0,
            "label": "Inv R"
          }
        ]
      }
    ]
  }
}
