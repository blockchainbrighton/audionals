{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Clean Gate",
    "description": "Simple gate preset using PrimarySourceEnhancer engine."
  },
  "config": {
    "name": "Clean Gate",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Gate",
    "modules": [
      {
        "name": "Gate",
        "cols": 1,
        "controls": [
          { "id": "thresh", "param": 0, "type": "slider", "min": -60, "max": 0, "val": -40, "label": "Threshold" },
          { "id": "range", "param": 1, "type": "knob", "min": -60, "max": 0, "val": -60, "label": "Range" }
        ]
      },
      {
        "name": "Timing",
        "cols": 1,
        "controls": [
          { "id": "attack", "param": 2, "type": "knob", "min": 0.1, "max": 100, "val": 2.0, "label": "Attack" },
          { "id": "release", "param": 3, "type": "knob", "min": 10, "max": 1000, "val": 120, "label": "Release" },
          { "id": "hold", "param": 4, "type": "knob", "min": 0, "max": 500, "val": 15, "label": "Hold" }
        ]
      },
      {
        "name": "Detector",
        "cols": 1,
        "controls": [
          { "id": "hpf", "param": 5, "type": "knob", "min": 20, "max": 1000, "val": 80, "curve": "log", "label": "HPF" },
          { "id": "lpf", "param": 6, "type": "knob", "min": 1000, "max": 20000, "val": 12000, "curve": "log", "label": "LPF" }
        ]
      }
    ],
    "presets": {
      "Init": { "thresh": -30, "range": -12, "attack": 5, "release": 200, "hold": 50, "hpf": 100, "lpf": 10000 },
      "Gate": { "thresh": -40, "range": -60, "attack": 2.0, "release": 120, "hold": 15, "hpf": 80, "lpf": 12000 },
      "Hard Gate": { "thresh": -35, "range": -60, "attack": 0.8, "release": 80, "hold": 5, "hpf": 120, "lpf": 16000 },
      "Soft Expander": { "thresh": -35, "range": -18, "attack": 5, "release": 250, "hold": 40, "hpf": 60, "lpf": 12000 }
    }
  }
}
