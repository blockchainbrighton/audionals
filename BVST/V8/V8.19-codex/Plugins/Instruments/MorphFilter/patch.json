{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Morph Filter",
    "description": "Legacy port preset over UniversalSynth (noise/drone focus)."
  },
  "config": {
    "name": "Morph Filter",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": false,
    "modules": [
      {
        "name": "Noise / Drive",
        "cols": 1,
        "controls": [
          {
            "id": "noise",
            "param": 8,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.6,
            "label": "Noise"
          },
          {
            "id": "drive",
            "param": 9,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.35,
            "label": "Drive"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.6,
            "label": "Master"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_mode",
            "param": 12,
            "type": "select",
            "options": [
              "LP",
              "HP",
              "BP",
              "Notch"
            ],
            "val": 2,
            "label": "Mode"
          },
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 1200,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 3.5,
            "label": "Res"
          }
        ]
      },
      {
        "name": "LFO",
        "cols": 1,
        "controls": [
          {
            "id": "lfo_rate",
            "param": 22,
            "type": "knob",
            "min": 0.1,
            "max": 20,
            "val": 0.6,
            "label": "Rate"
          },
          {
            "id": "lfo_depth",
            "param": 23,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.25,
            "label": "Depth"
          },
          {
            "id": "lfo_dest",
            "param": 24,
            "type": "select",
            "options": [
              "Off",
              "Cutoff",
              "Pitch"
            ],
            "val": 1,
            "label": "Dest"
          }
        ]
      }
    ],
    "presets": {
      "Init": {
        "noise": 0.6,
        "drive": 0.35,
        "master": 0.6,
        "filt_mode": 2,
        "filt_cut": 1200,
        "filt_res": 3.5,
        "lfo_rate": 0.6,
        "lfo_depth": 0.25,
        "lfo_dest": 1
      },
      "Wind Tunnel": {
        "noise": 0.85,
        "drive": 0.15,
        "master": 0.55,
        "filt_mode": 2,
        "filt_cut": 3200,
        "filt_res": 0.8,
        "lfo_rate": 0.25,
        "lfo_depth": 0.65,
        "lfo_dest": 1
      },
      "Riser": {
        "noise": 0.8,
        "drive": 0.45,
        "master": 0.55,
        "filt_mode": 0,
        "filt_cut": 250,
        "filt_res": 7.5,
        "lfo_rate": 0.18,
        "lfo_depth": 0.9,
        "lfo_dest": 1
      },
      "Robot AM": {
        "noise": 0.55,
        "drive": 0.6,
        "master": 0.5,
        "filt_mode": 3,
        "filt_cut": 900,
        "filt_res": 5.5,
        "lfo_rate": 6.0,
        "lfo_depth": 0.8,
        "lfo_dest": 2
      },
      "Sub Throb": {
        "noise": 0.35,
        "drive": 0.75,
        "master": 0.55,
        "filt_mode": 0,
        "filt_cut": 120,
        "filt_res": 2.2,
        "lfo_rate": 1.2,
        "lfo_depth": 0.35,
        "lfo_dest": 1
      },
      "Laser": {
        "noise": 0.65,
        "drive": 0.55,
        "master": 0.6,
        "filt_mode": 1,
        "filt_cut": 8500,
        "filt_res": 9.0,
        "lfo_rate": 12.0,
        "lfo_depth": 0.55,
        "lfo_dest": 2
      }
    }
  }
}
