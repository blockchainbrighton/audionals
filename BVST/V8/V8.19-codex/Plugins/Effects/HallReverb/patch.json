{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Hall Reverb",
    "description": "Hall-style preset over UniversalReverb."
  },
  "config": {
    "name": "Hall Reverb",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Hall",
    "modules": [
      {
        "name": "Reverb",
        "cols": 1,
        "controls": [
          { "id": "mix", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0.22, "label": "Mix" },
          { "id": "decay", "param": 1, "type": "knob", "min": 0, "max": 1, "val": 0.82, "label": "Decay" },
          { "id": "predelay", "param": 2, "type": "knob", "min": 0, "max": 0.25, "val": 0.04, "label": "Pre (s)" },
          { "id": "tone", "param": 3, "type": "knob", "min": 200, "max": 20000, "val": 9000, "curve": "log", "label": "Tone" },
          { "id": "width", "param": 4, "type": "knob", "min": 0, "max": 2, "val": 1.5, "label": "Width" }
        ]
      }
    ],
    "presets": {
      "Init": { "mix": 0.0, "decay": 0.8, "predelay": 0.0, "tone": 9000, "width": 1.0 },
      "Hall": { "mix": 0.22, "decay": 0.82, "predelay": 0.04, "tone": 9000, "width": 1.5 },
      "Deep Hall": { "mix": 0.3, "decay": 0.95, "predelay": 0.06, "tone": 6000, "width": 1.6 },
      "Short Hall": { "mix": 0.18, "decay": 0.6, "predelay": 0.03, "tone": 12000, "width": 1.35 }
    }
  }
}
