{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Plate Reverb",
    "description": "Bright plate-style preset over UniversalReverb."
  },
  "config": {
    "name": "Plate Reverb",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Plate",
    "modules": [
      {
        "name": "Reverb",
        "cols": 1,
        "controls": [
          { "id": "mix", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0.28, "label": "Mix" },
          { "id": "decay", "param": 1, "type": "knob", "min": 0, "max": 1, "val": 0.6, "label": "Decay" },
          { "id": "predelay", "param": 2, "type": "knob", "min": 0, "max": 0.25, "val": 0.02, "label": "Pre (s)" },
          { "id": "tone", "param": 3, "type": "knob", "min": 200, "max": 20000, "val": 16000, "curve": "log", "label": "Tone" },
          { "id": "width", "param": 4, "type": "knob", "min": 0, "max": 2, "val": 1.35, "label": "Width" }
        ]
      }
    ],
    "presets": {
      "Init": { "mix": 0.0, "decay": 0.6, "predelay": 0.0, "tone": 16000, "width": 1.0 },
      "Plate": { "mix": 0.28, "decay": 0.6, "predelay": 0.02, "tone": 16000, "width": 1.35 },
      "Vocal Plate": { "mix": 0.22, "decay": 0.52, "predelay": 0.035, "tone": 14000, "width": 1.25 },
      "Bright Plate": { "mix": 0.32, "decay": 0.7, "predelay": 0.015, "tone": 20000, "width": 1.45 }
    }
  }
}
