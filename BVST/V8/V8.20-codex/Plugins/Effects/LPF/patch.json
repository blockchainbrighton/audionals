{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "LPF",
    "description": "Low-pass filter with resonance and drive (UniversalFilter)."
  },
  "config": {
    "name": "LPF",
    "visualizer": "spectrum",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Init",
    "modules": [
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          { "id": "mode", "param": 0, "type": "select", "options": ["LP", "HP", "BP", "Notch"], "val": 0, "label": "Mode" },
          { "id": "cut", "param": 1, "type": "knob", "min": 20, "max": 20000, "val": 12000, "curve": "log", "label": "Cutoff" },
          { "id": "res", "param": 2, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" },
          { "id": "drive", "param": 3, "type": "knob", "min": 0, "max": 1, "val": 0.0, "label": "Drive" },
          { "id": "mix", "param": 4, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Mix" }
        ]
      }
    ],
    "presets": {
      "Init": { "mode": 0, "cut": 12000, "res": 0.7, "drive": 0.0, "mix": 1.0 },
      "Lo-Fi Lowpass": { "mode": 0, "cut": 2500, "res": 0.9, "drive": 0.0, "mix": 1.0 },
      "Res Sweep": { "mode": 0, "cut": 1200, "res": 2.5, "drive": 0.08, "mix": 1.0 }
    }
  }
}
