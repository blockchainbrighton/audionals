{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Universal FX",
    "description": "A multi-effect chain patch (drive, filter, modulation, stereo delay)."
  },
  "config": {
    "name": "Universal FX",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "modules": [
      {
        "name": "Pre-Amp",
        "cols": 1,
        "controls": [
          { "id": "drive", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0, "label": "Drive" }
        ]
      },
      {
        "name": "Mod Filter",
        "cols": 1,
        "controls": [
          { "id": "cut", "param": 1, "type": "knob", "min": 20, "max": 20000, "val": 5000, "curve": "log", "label": "Cutoff" },
          { "id": "res", "param": 2, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" },
          { "id": "lfo_rate", "param": 3, "type": "knob", "min": 0.1, "max": 10, "val": 1.0, "label": "LFO Rate" },
          { "id": "lfo_depth", "param": 4, "type": "knob", "min": 0, "max": 1, "val": 0.5, "label": "LFO Depth" }
        ]
      },
      {
        "name": "Stereo Delay",
        "cols": 1,
        "controls": [
          { "id": "time", "param": 5, "type": "knob", "min": 0, "max": 1, "val": 0.3, "label": "Time" },
          { "id": "feed", "param": 6, "type": "knob", "min": 0, "max": 0.95, "val": 0.4, "label": "Fdbk" },
          { "id": "mix", "param": 7, "type": "knob", "min": 0, "max": 1, "val": 0.3, "label": "Mix" }
        ]
      },
      {
        "name": "Master",
        "cols": 1,
        "controls": [
          { "id": "global_mix", "param": 8, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Dry/Wet" }
        ]
      }
    ]
  }
}

