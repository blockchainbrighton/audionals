{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Aurora Delay",
    "description": "Legacy port preset over UniversalFX."
  },
  "config": {
    "name": "Aurora Delay",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "modules": [
      {
        "name": "Tone / Drive",
        "cols": 1,
        "controls": [
          {
            "id": "drive",
            "param": 0,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.15,
            "label": "Drive"
          },
          {
            "id": "cut",
            "param": 1,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 8000,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "res",
            "param": 2,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 0.9,
            "label": "Res"
          }
        ]
      },
      {
        "name": "Mod",
        "cols": 1,
        "controls": [
          {
            "id": "lfo_rate",
            "param": 3,
            "type": "knob",
            "min": 0.1,
            "max": 10,
            "val": 0.35,
            "label": "LFO Rate"
          },
          {
            "id": "lfo_depth",
            "param": 4,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.25,
            "label": "LFO Depth"
          }
        ]
      },
      {
        "name": "Delay",
        "cols": 1,
        "controls": [
          {
            "id": "time",
            "param": 5,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.55,
            "label": "Time"
          },
          {
            "id": "feed",
            "param": 6,
            "type": "knob",
            "min": 0,
            "max": 0.95,
            "val": 0.6,
            "label": "Fdbk"
          },
          {
            "id": "mix",
            "param": 7,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.45,
            "label": "Mix"
          }
        ]
      },
      {
        "name": "Master",
        "cols": 1,
        "controls": [
          {
            "id": "global_mix",
            "param": 8,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 1.0,
            "label": "Dry/Wet"
          }
        ]
      }
    ]
  }
}
