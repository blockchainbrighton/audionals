{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "BassLine 303",
    "description": "Legacy port preset over UniversalSynth with step sequencer (shared engine)."
  },
  "config": {
    "name": "BassLine 303",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": {
      "type": "step",
      "steps": 16,
      "paramMap": {
        "note": 128,
        "gate": 129,
        "accent": -1,
        "slide": -1
      }
    },
    "modules": [
      {
        "name": "Transport",
        "cols": 1,
        "controls": [
          {
            "id": "btn-power",
            "param": -1,
            "type": "button",
            "text": "PWR",
            "label": "Context"
          },
          {
            "id": "btn-play",
            "param": -1,
            "type": "button",
            "text": "PLAY",
            "label": "Seq"
          },
          {
            "id": "btn-stop",
            "param": -1,
            "type": "button",
            "text": "STOP",
            "label": "Seq"
          },
          {
            "id": "bpm",
            "param": -1,
            "type": "knob",
            "min": 60,
            "max": 180,
            "val": 130,
            "label": "BPM"
          },
          {
            "id": "swing",
            "param": -1,
            "type": "knob",
            "min": 0,
            "max": 0.75,
            "val": 0.0,
            "label": "Swing"
          }
        ]
      },
      {
        "name": "Osc",
        "cols": 1,
        "controls": [
          {
            "id": "osc1_wave",
            "param": 0,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 1,
            "label": "Wave"
          },
          {
            "id": "osc1_mix",
            "param": 2,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 1.0,
            "label": "Level"
          },
          {
            "id": "osc2_mix",
            "param": 7,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.0,
            "label": "Osc2"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_mode",
            "param": 12,
            "type": "select",
            "options": [
              "LP",
              "HP",
              "BP",
              "Notch"
            ],
            "val": 0,
            "label": "Mode"
          },
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 600,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 6.0,
            "label": "Res"
          },
          {
            "id": "filt_env",
            "param": 13,
            "type": "knob",
            "min": -1,
            "max": 1,
            "val": 0.8,
            "label": "Env Amt"
          }
        ]
      },
      {
        "name": "Env",
        "cols": 1,
        "controls": [
          {
            "id": "amp_d",
            "param": 15,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.25,
            "label": "Amp D"
          },
          {
            "id": "amp_s",
            "param": 16,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.0,
            "label": "Amp S"
          },
          {
            "id": "amp_r",
            "param": 17,
            "type": "slider",
            "min": 0.001,
            "max": 5,
            "val": 0.15,
            "label": "Amp R"
          },
          {
            "id": "filt_d",
            "param": 19,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.22,
            "label": "Filt D"
          }
        ]
      },
      {
        "name": "Drive",
        "cols": 1,
        "controls": [
          {
            "id": "drive",
            "param": 9,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.55,
            "label": "Drive"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.8,
            "label": "Master"
          }
        ]
      }
    ],
    "presets": {
      "Init": {
        "bpm": 130,
        "swing": 0.0,
        "osc1_wave": 1,
        "osc1_mix": 1.0,
        "osc2_mix": 0.0,
        "filt_mode": 0,
        "filt_cut": 600,
        "filt_res": 6.0,
        "filt_env": 0.8,
        "amp_d": 0.25,
        "amp_s": 0.0,
        "amp_r": 0.15,
        "filt_d": 0.22,
        "drive": 0.55,
        "master": 0.8
      },
      "Acid Classic": {
        "bpm": 132,
        "swing": 0.1,
        "osc1_wave": 1,
        "osc1_mix": 1.0,
        "osc2_mix": 0.0,
        "filt_mode": 0,
        "filt_cut": 420,
        "filt_res": 8.6,
        "filt_env": 0.95,
        "amp_d": 0.2,
        "amp_s": 0.0,
        "amp_r": 0.09,
        "filt_d": 0.18,
        "drive": 0.75,
        "master": 0.78
      },
      "Rubber Bass": {
        "bpm": 124,
        "swing": 0.18,
        "osc1_wave": 2,
        "osc1_mix": 1.0,
        "osc2_mix": 0.15,
        "filt_mode": 0,
        "filt_cut": 250,
        "filt_res": 2.2,
        "filt_env": 0.55,
        "amp_d": 0.35,
        "amp_s": 0.0,
        "amp_r": 0.2,
        "filt_d": 0.28,
        "drive": 0.45,
        "master": 0.85
      },
      "Hollow Square": {
        "bpm": 128,
        "swing": 0.0,
        "osc1_wave": 2,
        "osc1_mix": 0.85,
        "osc2_mix": 0.3,
        "filt_mode": 1,
        "filt_cut": 950,
        "filt_res": 4.2,
        "filt_env": 0.4,
        "amp_d": 0.18,
        "amp_s": 0.0,
        "amp_r": 0.12,
        "filt_d": 0.2,
        "drive": 0.25,
        "master": 0.8
      },
      "Reso Sweep": {
        "bpm": 140,
        "swing": 0.05,
        "osc1_wave": 1,
        "osc1_mix": 1.0,
        "osc2_mix": 0.0,
        "filt_mode": 0,
        "filt_cut": 1200,
        "filt_res": 9.5,
        "filt_env": 0.2,
        "amp_d": 0.55,
        "amp_s": 0.0,
        "amp_r": 0.25,
        "filt_d": 0.75,
        "drive": 0.5,
        "master": 0.7
      },
      "Subby": {
        "bpm": 118,
        "swing": 0.0,
        "osc1_wave": 0,
        "osc1_mix": 1.0,
        "osc2_mix": 0.0,
        "filt_mode": 0,
        "filt_cut": 180,
        "filt_res": 0.8,
        "filt_env": 0.0,
        "amp_d": 0.25,
        "amp_s": 1.0,
        "amp_r": 0.2,
        "filt_d": 0.12,
        "drive": 0.15,
        "master": 0.85
      }
    }
  }
}
