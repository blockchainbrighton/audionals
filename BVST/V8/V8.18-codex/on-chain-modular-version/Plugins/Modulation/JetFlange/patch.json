{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Jet Flange",
    "description": "Flanger preset over UniversalMod (feedback + short modulation)."
  },
  "config": {
    "name": "Jet Flange",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Jet",
    "modules": [
      {
        "name": "Flange",
        "cols": 1,
        "controls": [
          { "id": "rate", "param": 0, "type": "knob", "min": 0.1, "max": 10, "val": 0.22, "label": "Rate" },
          { "id": "depth", "param": 1, "type": "knob", "min": 0, "max": 0.02, "val": 0.0022, "label": "Depth" },
          { "id": "feed", "param": 2, "type": "knob", "min": 0, "max": 0.95, "val": 0.72, "label": "Fdbk" },
          { "id": "spread", "param": 4, "type": "knob", "min": 0, "max": 3.14, "val": 3.14, "label": "Stereo" },
          { "id": "mix", "param": 3, "type": "knob", "min": 0, "max": 1, "val": 0.75, "label": "Mix" }
        ]
      }
    ],
    "presets": {
      "Init": { "rate": 0.5, "depth": 0.002, "feed": 0.3, "spread": 3.14, "mix": 0.5 },
      "Jet": { "rate": 0.22, "depth": 0.0022, "feed": 0.72, "spread": 3.14, "mix": 0.75 },
      "Slow Sweep": { "rate": 0.12, "depth": 0.003, "feed": 0.55, "spread": 3.14, "mix": 0.7 },
      "Metallic": { "rate": 0.35, "depth": 0.0015, "feed": 0.8, "spread": 3.14, "mix": 0.8 }
    }
  }
}
