{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Tape Delay",
    "description": "Tape delay flavored preset over UniversalFX (drive + gentle modulation + stereo delay)."
  },
  "config": {
    "name": "Tape Delay",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Tape",
    "modules": [
      {
        "name": "Tone",
        "cols": 1,
        "controls": [
          { "id": "drive", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0.18, "label": "Drive" },
          { "id": "cut", "param": 1, "type": "knob", "min": 20, "max": 20000, "val": 6500, "curve": "log", "label": "Cutoff" },
          { "id": "res", "param": 2, "type": "knob", "min": 0.5, "max": 10, "val": 0.8, "label": "Res" }
        ]
      },
      {
        "name": "Mod",
        "cols": 1,
        "controls": [
          { "id": "lfo_rate", "param": 3, "type": "knob", "min": 0.1, "max": 10, "val": 0.35, "label": "Rate" },
          { "id": "lfo_depth", "param": 4, "type": "knob", "min": 0, "max": 1, "val": 0.18, "label": "Depth" }
        ]
      },
      {
        "name": "Delay",
        "cols": 1,
        "controls": [
          { "id": "time", "param": 5, "type": "knob", "min": 0, "max": 1, "val": 0.35, "label": "Time (s)" },
          { "id": "feed", "param": 6, "type": "knob", "min": 0, "max": 0.95, "val": 0.55, "label": "Fdbk" },
          { "id": "mix", "param": 7, "type": "knob", "min": 0, "max": 1, "val": 0.32, "label": "Mix" }
        ]
      },
      {
        "name": "Master",
        "cols": 1,
        "controls": [
          { "id": "global_mix", "param": 8, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Dry/Wet" }
        ]
      }
    ],
    "presets": {
      "Init": { "drive": 0.0, "cut": 10000, "res": 0.7, "lfo_rate": 1.0, "lfo_depth": 0.0, "time": 0.3, "feed": 0.35, "mix": 0.25, "global_mix": 1.0 },
      "Tape": { "drive": 0.18, "cut": 6500, "res": 0.8, "lfo_rate": 0.35, "lfo_depth": 0.18, "time": 0.35, "feed": 0.55, "mix": 0.32, "global_mix": 1.0 },
      "Wow & Flutter": { "drive": 0.22, "cut": 5500, "res": 0.9, "lfo_rate": 0.55, "lfo_depth": 0.28, "time": 0.42, "feed": 0.6, "mix": 0.33, "global_mix": 1.0 },
      "Dub": { "drive": 0.12, "cut": 4200, "res": 0.85, "lfo_rate": 0.25, "lfo_depth": 0.2, "time": 0.55, "feed": 0.78, "mix": 0.4, "global_mix": 1.0 }
    }
  }
}
