{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Digital Delay",
    "description": "Clean digital delay preset over UniversalFX."
  },
  "config": {
    "name": "Digital Delay",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Digital",
    "modules": [
      {
        "name": "Delay",
        "cols": 1,
        "controls": [
          { "id": "time", "param": 5, "type": "knob", "min": 0, "max": 1, "val": 0.4, "label": "Time (s)" },
          { "id": "feed", "param": 6, "type": "knob", "min": 0, "max": 0.95, "val": 0.45, "label": "Fdbk" },
          { "id": "mix", "param": 7, "type": "knob", "min": 0, "max": 1, "val": 0.28, "label": "Mix" },
          { "id": "global_mix", "param": 8, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Dry/Wet" }
        ]
      },
      {
        "name": "Tone",
        "cols": 1,
        "controls": [
          { "id": "drive", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0.0, "label": "Drive" },
          { "id": "cut", "param": 1, "type": "knob", "min": 20, "max": 20000, "val": 18000, "curve": "log", "label": "Cutoff" },
          { "id": "res", "param": 2, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" }
        ]
      }
    ],
    "presets": {
      "Digital": { "time": 0.4, "feed": 0.45, "mix": 0.28, "global_mix": 1.0, "drive": 0.0, "cut": 18000, "res": 0.7 },
      "Bright Echo": { "time": 0.28, "feed": 0.35, "mix": 0.32, "global_mix": 1.0, "drive": 0.0, "cut": 20000, "res": 0.7 },
      "Long Echo": { "time": 0.75, "feed": 0.55, "mix": 0.25, "global_mix": 1.0, "drive": 0.0, "cut": 14000, "res": 0.7 }
    }
  }
}
