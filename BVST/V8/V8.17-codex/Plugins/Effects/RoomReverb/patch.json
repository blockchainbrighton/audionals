{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Room Reverb",
    "description": "Stereo room reverb with predelay, damping, and width (UniversalReverb)."
  },
  "config": {
    "name": "Room Reverb",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Room",
    "modules": [
      {
        "name": "Reverb",
        "cols": 1,
        "controls": [
          { "id": "mix", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0.25, "label": "Mix" },
          { "id": "decay", "param": 1, "type": "knob", "min": 0, "max": 1, "val": 0.35, "label": "Decay" },
          { "id": "predelay", "param": 2, "type": "knob", "min": 0, "max": 0.25, "val": 0.015, "label": "Pre (s)" },
          { "id": "tone", "param": 3, "type": "knob", "min": 200, "max": 20000, "val": 12000, "curve": "log", "label": "Tone" },
          { "id": "width", "param": 4, "type": "knob", "min": 0, "max": 2, "val": 1.1, "label": "Width" }
        ]
      }
    ],
    "presets": {
      "Init": { "mix": 0.0, "decay": 0.5, "predelay": 0.0, "tone": 12000, "width": 1.0 },
      "Room": { "mix": 0.25, "decay": 0.35, "predelay": 0.015, "tone": 12000, "width": 1.1 },
      "Ambience": { "mix": 0.18, "decay": 0.22, "predelay": 0.0, "tone": 16000, "width": 1.25 },
      "Dark Room": { "mix": 0.3, "decay": 0.4, "predelay": 0.02, "tone": 4000, "width": 1.0 }
    }
  }
}
