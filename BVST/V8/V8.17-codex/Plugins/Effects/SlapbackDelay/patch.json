{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Slapback Delay",
    "description": "Fast, short delay preset over UniversalFX."
  },
  "config": {
    "name": "Slapback Delay",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Slapback",
    "modules": [
      {
        "name": "Delay",
        "cols": 1,
        "controls": [
          { "id": "time", "param": 5, "type": "knob", "min": 0, "max": 1, "val": 0.09, "label": "Time (s)" },
          { "id": "feed", "param": 6, "type": "knob", "min": 0, "max": 0.95, "val": 0.18, "label": "Fdbk" },
          { "id": "mix", "param": 7, "type": "knob", "min": 0, "max": 1, "val": 0.22, "label": "Mix" },
          { "id": "global_mix", "param": 8, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Dry/Wet" }
        ]
      },
      {
        "name": "Tone",
        "cols": 1,
        "controls": [
          { "id": "drive", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0.0, "label": "Drive" },
          { "id": "cut", "param": 1, "type": "knob", "min": 20, "max": 20000, "val": 12000, "curve": "log", "label": "Cutoff" },
          { "id": "res", "param": 2, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" }
        ]
      }
    ],
    "presets": {
      "Init": { "time": 0.1, "feed": 0.2, "mix": 0.2, "global_mix": 1.0, "drive": 0.0, "cut": 12000, "res": 0.7 },
      "Slapback": { "time": 0.09, "feed": 0.18, "mix": 0.22, "global_mix": 1.0, "drive": 0.0, "cut": 12000, "res": 0.7 },
      "Thickener": { "time": 0.06, "feed": 0.12, "mix": 0.28, "global_mix": 1.0, "drive": 0.05, "cut": 9000, "res": 0.7 }
    }
  }
}
