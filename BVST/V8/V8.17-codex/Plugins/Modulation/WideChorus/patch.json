{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Wide Chorus",
    "description": "Wide chorus preset over UniversalMod."
  },
  "config": {
    "name": "Wide Chorus",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Wide",
    "modules": [
      {
        "name": "Chorus",
        "cols": 1,
        "controls": [
          { "id": "rate", "param": 0, "type": "knob", "min": 0.1, "max": 10, "val": 0.35, "label": "Rate" },
          { "id": "depth", "param": 1, "type": "knob", "min": 0, "max": 0.02, "val": 0.012, "label": "Depth" },
          { "id": "feed", "param": 2, "type": "knob", "min": 0, "max": 0.95, "val": 0.12, "label": "Fdbk" },
          { "id": "spread", "param": 4, "type": "knob", "min": 0, "max": 3.14, "val": 3.14, "label": "Stereo" },
          { "id": "mix", "param": 3, "type": "knob", "min": 0, "max": 1, "val": 0.65, "label": "Mix" }
        ]
      }
    ],
    "presets": {
      "Init": { "rate": 0.5, "depth": 0.005, "feed": 0.3, "spread": 1.57, "mix": 0.5 },
      "Wide": { "rate": 0.35, "depth": 0.012, "feed": 0.12, "spread": 3.14, "mix": 0.65 },
      "Thick": { "rate": 0.25, "depth": 0.015, "feed": 0.18, "spread": 3.14, "mix": 0.75 },
      "Subtle": { "rate": 0.55, "depth": 0.006, "feed": 0.1, "spread": 3.14, "mix": 0.35 }
    }
  }
}
