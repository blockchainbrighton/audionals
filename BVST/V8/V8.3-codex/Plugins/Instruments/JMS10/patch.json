{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "JMS10",
    "description": "Legacy port: MS-10 style monosynth preset (shared engine)."
  },
  "config": {
    "name": "JMS10",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": false,
    "modules": [
      {
        "name": "Osc",
        "cols": 1,
        "controls": [
          {
            "id": "osc1_wave",
            "param": 0,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 2,
            "label": "Wave"
          },
          {
            "id": "osc1_mix",
            "param": 2,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.9,
            "label": "Level"
          },
          {
            "id": "noise",
            "param": 8,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.05,
            "label": "Noise"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_mode",
            "param": 12,
            "type": "select",
            "options": [
              "LP",
              "HP",
              "BP",
              "Notch"
            ],
            "val": 0,
            "label": "Mode"
          },
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 1100,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 3.5,
            "label": "Res"
          },
          {
            "id": "filt_env",
            "param": 13,
            "type": "knob",
            "min": -1,
            "max": 1,
            "val": 0.5,
            "label": "Env Amt"
          }
        ]
      },
      {
        "name": "Env",
        "cols": 1,
        "controls": [
          {
            "id": "amp_a",
            "param": 14,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.005,
            "label": "A"
          },
          {
            "id": "amp_d",
            "param": 15,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.18,
            "label": "D"
          },
          {
            "id": "amp_s",
            "param": 16,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.0,
            "label": "S"
          },
          {
            "id": "amp_r",
            "param": 17,
            "type": "slider",
            "min": 0.001,
            "max": 5,
            "val": 0.12,
            "label": "R"
          }
        ]
      },
      {
        "name": "Out",
        "cols": 1,
        "controls": [
          {
            "id": "drive",
            "param": 9,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.15,
            "label": "Drive"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.8,
            "label": "Master"
          }
        ]
      }
    ]
  }
}
