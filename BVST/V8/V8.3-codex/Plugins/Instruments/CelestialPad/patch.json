{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Celestial Pad",
    "description": "Legacy port preset over UniversalSynth."
  },
  "config": {
    "name": "Celestial Pad",
    "visualizer": "spectrum",
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "sequencer": false,
    "modules": [
      {
        "name": "Osc Mix",
        "cols": 1,
        "controls": [
          {
            "id": "osc1_wave",
            "param": 0,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 1,
            "label": "Wave"
          },
          {
            "id": "osc1_mix",
            "param": 2,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.7,
            "label": "Level"
          },
          {
            "id": "osc2_wave",
            "param": 4,
            "type": "select",
            "options": [
              "Sine",
              "Saw",
              "Square",
              "Pulse"
            ],
            "val": 1,
            "label": "Wave"
          },
          {
            "id": "osc2_det",
            "param": 6,
            "type": "knob",
            "min": 0,
            "max": 0.5,
            "val": 0.15,
            "label": "Detune"
          },
          {
            "id": "osc2_mix",
            "param": 7,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.85,
            "label": "Osc2"
          }
        ]
      },
      {
        "name": "Filter",
        "cols": 1,
        "controls": [
          {
            "id": "filt_cut",
            "param": 10,
            "type": "knob",
            "min": 20,
            "max": 20000,
            "val": 2200,
            "curve": "log",
            "label": "Cutoff"
          },
          {
            "id": "filt_res",
            "param": 11,
            "type": "knob",
            "min": 0.5,
            "max": 10,
            "val": 1.2,
            "label": "Res"
          }
        ]
      },
      {
        "name": "Amp Env",
        "cols": 1,
        "controls": [
          {
            "id": "amp_a",
            "param": 14,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 1.0,
            "label": "A"
          },
          {
            "id": "amp_d",
            "param": 15,
            "type": "slider",
            "min": 0.001,
            "max": 2,
            "val": 0.8,
            "label": "D"
          },
          {
            "id": "amp_s",
            "param": 16,
            "type": "slider",
            "min": 0,
            "max": 1,
            "val": 0.9,
            "label": "S"
          },
          {
            "id": "amp_r",
            "param": 17,
            "type": "slider",
            "min": 0.001,
            "max": 5,
            "val": 2.5,
            "label": "R"
          }
        ]
      },
      {
        "name": "LFO",
        "cols": 1,
        "controls": [
          {
            "id": "lfo_rate",
            "param": 22,
            "type": "knob",
            "min": 0.1,
            "max": 20,
            "val": 0.35,
            "label": "Rate"
          },
          {
            "id": "lfo_depth",
            "param": 23,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.12,
            "label": "Depth"
          },
          {
            "id": "lfo_dest",
            "param": 24,
            "type": "select",
            "options": [
              "Off",
              "Cutoff",
              "Pitch"
            ],
            "val": 1,
            "label": "Dest"
          }
        ]
      },
      {
        "name": "Delay",
        "cols": 1,
        "controls": [
          {
            "id": "dly_time",
            "param": 26,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.6,
            "label": "Time"
          },
          {
            "id": "dly_feed",
            "param": 27,
            "type": "knob",
            "min": 0,
            "max": 0.95,
            "val": 0.7,
            "label": "Fdbk"
          },
          {
            "id": "dly_mix",
            "param": 28,
            "type": "knob",
            "min": 0,
            "max": 1,
            "val": 0.45,
            "label": "Mix"
          },
          {
            "id": "master",
            "param": 29,
            "type": "slider",
            "min": 0,
            "max": 2,
            "val": 0.75,
            "label": "Master"
          }
        ]
      }
    ]
  }
}
