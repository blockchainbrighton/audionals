{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "GrainCloud",
    "description": "Granular sampler patch (pos/spread/density/size)."
  },
  "config": {
    "name": "GrainCloud",
    "visualizer": "spectrum",
    "sampler": {},
    "keyboard": {
      "startNote": 36,
      "numKeys": 49
    },
    "modules": [
      {
        "name": "Transport",
        "cols": 1,
        "controls": [
          { "id": "btn-power", "param": -1, "type": "button", "text": "PWR", "label": "Context" }
        ]
      },
      {
        "name": "Granular",
        "cols": 1,
        "controls": [
          { "id": "pos", "param": 5, "type": "slider", "min": 0, "max": 1, "val": 0.5, "label": "Pos" },
          { "id": "spread", "param": 6, "type": "knob", "min": 0, "max": 1, "val": 0.15, "label": "Spread" },
          { "id": "density", "param": 7, "type": "knob", "min": 1, "max": 100, "val": 20, "label": "Density" },
          { "id": "size_ms", "param": 8, "type": "knob", "min": 10, "max": 500, "val": 120, "label": "Size (ms)" },
          { "id": "speed", "param": 0, "type": "knob", "min": 0, "max": 4, "val": 1.0, "label": "Speed" },
          { "id": "reverse", "param": 4, "type": "switch", "val": 0, "label": "Reverse" }
        ]
      },
      {
        "name": "Filter / Env / Mix",
        "cols": 1,
        "controls": [
          { "id": "filt_mode", "param": 13, "type": "select", "options": ["LP", "HP", "BP", "Notch"], "val": 0, "label": "Mode" },
          { "id": "cut", "param": 11, "type": "knob", "min": 20, "max": 20000, "val": 15000, "curve": "log", "label": "Cut" },
          { "id": "res", "param": 12, "type": "knob", "min": 0.5, "max": 10, "val": 0.8, "label": "Res" },
          { "id": "att", "param": 20, "type": "slider", "min": 0.001, "max": 2, "val": 0.005, "label": "A" },
          { "id": "rel", "param": 21, "type": "slider", "min": 0.001, "max": 5, "val": 0.25, "label": "R" },
          { "id": "gain", "param": 22, "type": "knob", "min": 0, "max": 2, "val": 0.8, "label": "Gain" },
          { "id": "drive", "param": 23, "type": "knob", "min": 0, "max": 1, "val": 0.0, "label": "Drive" }
        ]
      }
    ],
    "presets": {
      "Init": {
        "pos": 0.5,
        "spread": 0.15,
        "density": 20,
        "size_ms": 120,
        "speed": 1.0,
        "reverse": 0,
        "filt_mode": 0,
        "cut": 15000,
        "res": 0.8,
        "att": 0.005,
        "rel": 0.25,
        "gain": 0.8,
        "drive": 0.0
      }
    }
  }
}
