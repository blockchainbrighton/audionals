{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Tap Delay",
    "description": "Tap-tempo delay preset over UniversalFX (tap updates Time)."
  },
  "config": {
    "name": "Tap Delay",
    "visualizer": "scope",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Init",
    "modules": [
      {
        "name": "Delay",
        "cols": 1,
        "controls": [
          { "id": "tap", "param": -1, "type": "button", "text": "TAP", "label": "Tap" },
          { "id": "time", "param": 5, "type": "knob", "min": 0, "max": 1, "val": 0.35, "label": "Time (s)" },
          { "id": "feed", "param": 6, "type": "knob", "min": 0, "max": 0.95, "val": 0.5, "label": "Fdbk" },
          { "id": "mix", "param": 7, "type": "knob", "min": 0, "max": 1, "val": 0.3, "label": "Mix" },
          { "id": "global_mix", "param": 8, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Dry/Wet" }
        ]
      },
      {
        "name": "Tone",
        "cols": 1,
        "controls": [
          { "id": "drive", "param": 0, "type": "knob", "min": 0, "max": 1, "val": 0.08, "label": "Drive" },
          { "id": "cut", "param": 1, "type": "knob", "min": 20, "max": 20000, "val": 9000, "curve": "log", "label": "Cutoff" },
          { "id": "res", "param": 2, "type": "knob", "min": 0.5, "max": 10, "val": 0.7, "label": "Res" }
        ]
      }
    ],
    "presets": {
      "Init": { "time": 0.35, "feed": 0.5, "mix": 0.3, "global_mix": 1.0, "drive": 0.08, "cut": 9000, "res": 0.7 }
    }
  }
}
