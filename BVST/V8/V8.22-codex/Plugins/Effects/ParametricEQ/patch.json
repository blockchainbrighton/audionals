{
  "schema": "bvst.patch/v1",
  "meta": {
    "name": "Parametric EQ",
    "description": "Single-band parametric EQ with dry/wet and output trim."
  },
  "config": {
    "name": "Parametric EQ",
    "visualizer": "spectrum",
    "keyboard": false,
    "sequencer": false,
    "defaultPreset": "Init",
    "modules": [
      {
        "name": "Band",
        "cols": 1,
        "controls": [
          { "id": "freq", "param": 0, "type": "knob", "min": 20, "max": 20000, "val": 1000, "curve": "log", "label": "Freq" },
          { "id": "q", "param": 1, "type": "knob", "min": 0.1, "max": 10, "val": 0.7, "label": "Q" },
          { "id": "gain", "param": 2, "type": "slider", "min": -24, "max": 24, "val": 0, "label": "Gain (dB)" }
        ]
      },
      {
        "name": "Output",
        "cols": 1,
        "controls": [
          { "id": "mix", "param": 3, "type": "slider", "min": 0, "max": 1, "val": 1.0, "label": "Mix" },
          { "id": "out", "param": 4, "type": "knob", "min": -12, "max": 12, "val": 0, "label": "Out (dB)" }
        ]
      }
    ],
    "presets": {
      "Init": { "freq": 1000, "q": 0.7, "gain": 0, "mix": 1.0, "out": 0 },
      "Presence Boost": { "freq": 3500, "q": 1.2, "gain": 3.0, "mix": 1.0, "out": 0 },
      "Mud Cut": { "freq": 250, "q": 1.0, "gain": -4.5, "mix": 1.0, "out": 0 },
      "Air Lift": { "freq": 12000, "q": 0.8, "gain": 3.5, "mix": 1.0, "out": 0 }
    }
  }
}
