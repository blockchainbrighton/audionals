{
  "protocol": "BVST_ORD_v1",
  "name": "AlienBass",
  "plugin_type": "instrument",
  "audio_io": {
    "inputs": 0,
    "outputs": 2
  },
  "components": {
    "audio_engine": "./bvst_engine_bg.wasm", 
    "glue_script": "./processor.js",
    "ui_html": "./gui.html"
  },
  "parameters": [
    { 
      "id": 0, "name": "Frequency", 
      "min": 20.0, "max": 2000.0, "default": 110.0, "step": 1.0, "unit": "Hz" 
    },
    { 
      "id": 1, "name": "Gain", 
      "min": 0.0, "max": 1.0, "default": 0.5, "step": 0.01, "unit": "" 
    },
    { 
      "id": 2, "name": "FM Depth", 
      "min": 0.0, "max": 2000.0, "default": 500.0, "step": 10.0, "unit": "" 
    },
    { 
      "id": 3, "name": "FM Ratio", 
      "min": 0.0, "max": 10.0, "default": 2.0, "step": 0.1, "unit": "" 
    },
    { 
      "id": 4, "name": "LFO Rate", 
      "min": 0.0, "max": 20.0, "default": 0.5, "step": 0.1, "unit": "Hz" 
    }
  ]
}