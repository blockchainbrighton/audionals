# ============================================================================\n# GIT IGNORE - Audiobook Studio\n# ============================================================================\n\n# Environment\n.env\n.env.local\n.env.*.local\n\n# Node modules\nnode_modules/\nnpm-debug.log*\nyarn-debug.log*\nyarn-error.log*\npnpm-debug.log*\n\n# Build outputs\ndist/\nbuild/\n.next/\nout/\n\n# Python\n__pycache__/\n*.py[cod]\n*$py.class\n*.so\n.Python\nvenv/\nenv/\nENV/\n.venv\n\n# IDE\n.vscode/\n.idea/\n*.swp\n*.swo\n*~\n.DS_Store\n\n# Data\ndata/\nuploads/\n*.db\n*.sqlite\n*.sqlite3\n\n# Logs\nlogs/\n*.log\n\n# Cache\n.cache/\n.pytest_cache/\n.eslintcache\n\n# Docker\n.dockerignore\n\n# OS\nThumbs.db\n.DS_Store\n\n# Temporary\n*.tmp\n*.temp\n.tmp/\n\n# Models (large files)\nmodels/*.pt\nmodels/*.pth\nmodels/*.onnx\n\n# Audio files (large)\n*.wav\n*.mp3\n*.flac\n*.m4b\n\n# Backups\n*.backup\n*.bak\n
